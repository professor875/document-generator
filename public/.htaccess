# SPA fallback for Apache (Hostinger shared hosting).
# Routes like /dashboard are handled by Vue Router in the browser,
# not by actual files on disk.  This rule sends all non-file requests
# back to index.html so the client-side router can handle them.

RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
